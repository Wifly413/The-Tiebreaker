# Proveedor de IA (OpenCode Console, API compatible con OpenAI)
# Crea una clave en https://opencode.ai/console y añádela como secreto en Render.
OPENCODE_API_KEY="sk-..."

# Modelo. Debe ser de PAGO o de Go: los modelos gratuitos de OpenCode solo
# funcionan dentro de OpenCode y devuelven 403 a clientes externos.
# Baratos y buenos en español: deepseek-v4.1-flash, glm-5.3-flash, gpt-5-nano.
OPENCODE_MODEL="deepseek-v4.1-flash"

# Endpoint. Con suscripción Go usa el prefijo /go/ (el servidor envía el
# User-Agent de producto y la cabecera x-opencode-session que Go exige).
OPENCODE_BASE_URL="https://opencode.ai/inference/go/openai/v1"
# Con saldo de pago por uso (sin Go): https://opencode.ai/inference/openai/v1
OPENCODE_TEMPERATURE="0.5"
OPENCODE_JSON_MODE="json_object"   # "none" si tu modelo rechaza response_format
OPENCODE_TIMEOUT_MS="60000"

# Límites de la demo (protegen tu saldo)
RATE_LIMIT_WINDOW_MS="600000"      # 10 min
RATE_LIMIT_MAX="8"                 # lecturas por IP y ventana
DAILY_LIMIT="300"                  # lecturas por instancia y día
